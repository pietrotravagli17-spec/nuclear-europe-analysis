{
  "name": "Nuclear Europe",
  "dataColors": [
    "#1F3A5F",
    "#F2A541",
    "#2A9D8F",
    "#E76F51",
    "#8AA1B9",
    "#6C5B7B",
    "#C9CED6",
    "#264653"
  ],
  "good": "#2A9D8F",
  "neutral": "#F2A541",
  "bad": "#E76F51",
  "maximum": "#1F3A5F",
  "center": "#8AA1B9",
  "minimum": "#E8EDF3",
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "tableAccent": "#1F3A5F",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F3A5F"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2937"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2937"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#4B5563"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E5E7EB" } },
            "radius": 8
          }
        ],
        "dropShadow": [
          { "show": false }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#1F2937" } },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "valueAxis": [
          {
            "gridlineColor": { "solid": { "color": "#EEF1F5" } },
            "labelColor": { "solid": { "color": "#6B7280" } },
            "titleColor": { "solid": { "color": "#6B7280" } }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": { "solid": { "color": "#6B7280" } },
            "titleColor": { "solid": { "color": "#6B7280" } }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#F4F6F9" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#F4F6F9" } }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#1F3A5F" } },
            "fontSize": 28,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#6B7280" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [ { "show": false } ],
        "border": [ { "show": false } ]
      }
    },
    "slicer": {
      "*": {
        "background": [ { "show": false } ],
        "border": [ { "show": false } ]
      }
    }
  }
}
